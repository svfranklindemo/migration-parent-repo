{
  "definitions": [
    {
      "title": "Product Card",
      "id": "product-card",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Product Card",
              "model": "product-card"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "product-card",
      "fields": [
        {
          "component": "tab",
          "label": "Basic",
          "name": "basic"
        },
        {
          "component": "aem-content",
          "name": "contentFragmentFolder",
          "label": "Content Fragment Folder",
          "description": "Select folder containing particular product content fragments",
          "valueType": "string",
          "validation": {
            "rootPath": "/content/dam"
          }
        },
        {
          "component": "select",
          "name": "layout",
          "label": "Layout",
          "valueType": "string",
          "value": "stacked",
          "options": [
            {
              "name": "Stacked",
              "value": "stacked"
            },
            {
              "name": "Compact Stacked Card",
              "value": "compact-stacked-card"
            },
            {
              "name": "Side by Side",
              "value": "side-by-side"
            }
          ]
        },
        {
          "component": "text",
          "name": "buttonText",
          "label": "Button Text",
          "valueType": "string"
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Button Link",
          "description": "Button link for entire card"
        },
        {
          "component": "select",
          "name": "ctastyle",
          "label": "CTA Style",
          "valueType": "string",
          "value": "button",
          "options": [
            {
              "name": "Primary Button",
              "value": "button"
            },
            {
              "name": "Secondary Button",
              "value": "button-secondary"
            },
            {
              "name": "Dark Button",
              "value": "button-dark"
            }
          ]
        },
        {
          "component": "select",
          "name": "alignment",
          "label": "Alignment",
          "options": [
            {
              "name": "Left",
              "value": "left"
            },
            {
              "name": "Center",
              "value": "center"
            },
            {
              "name": "Right",
              "value": "right"
            }
          ]
        },
        {
          "component": "boolean",
          "name": "hideDescription",
          "label": "Hide Description",
          "value": "false",
          "valueType": "boolean"
        },
        {
          "component": "boolean",
          "name": "addBorder",
          "label": "Add Border",
          "value": "false",
          "valueType": "boolean"
        },
        {
          "component": "text",
          "name": "buttoneventtype",
          "label": "Button Event Type",
          "value": "",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "custom-class",
          "label": "Custom class",
          "value": "",
          "valueType": "string",
          "description": "Space-separated class names to add to the block"
        },
        {
          "component": "tab",
          "label": "Mobile Specific",
          "name": "mobileSpecific"
        },
        {
          "component": "select",
          "name": "mobilecardstyle",
          "label": "Card Type",
          "valueType": "string",
          "value": "overlay",
          "options": [
            {
              "name": "Image and text in one line",
              "value": "image-text-one-line"
            },
            {
              "name": "Image and text overlay",
              "value": "overlay"
            },
            {
              "name": "Image and text below",
              "value": "stacked"
            },
            {
              "name": "Image partially overlayed",
              "value": "partial-overlay"
            }
          ]
        },
        {
          "component": "select",
          "name": "mobileimagestyle",
          "label": "Image Resize Mode",
          "valueType": "string",
          "value": "",
          "options": [
            {
              "name": "Contain",
              "value": "contain"
            },
            {
              "name": "Cover",
              "value": "cover"
            }
          ]
        },
        {
          "component": "boolean",
          "name": "mobileshowbutton",
          "label": "Show Button",
          "value": "false",
          "valueType": "boolean",
          "description": "Show a button on the card. Its text and link come from Button Text and Button Link."
        },
        {
          "component": "select",
          "name": "mobilebuttonvariant",
          "label": "Button Variant",
          "options": [
            {
              "name": "Primary",
              "value": "contained"
            },
            {
              "name": "Secondary",
              "value": "contained-tonal"
            },
            {
              "name": "Outlined",
              "value": "outlined"
            },
            {
              "name": "Quiet",
              "value": "text"
            },
            {
              "name": "Elevated",
              "value": "elevated"
            }
          ],
          "description": "Leave empty to follow the CTA Style."
        },
        {
          "component": "text",
          "name": "mobilebuttoneventtype",
          "label": "Mobile Button Event Type",
          "value": "",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "custommobilestyle",
          "label": "Custom Mobile Style",
          "value": "",
          "valueType": "string[]",
          "description": "Custom styles for the card on mobile",
          "multi": true
        }
      ]
    }
  ],
  "filters": []
}
